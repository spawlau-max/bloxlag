# Configuración opcional de APIs oficiales para sincronización directa en el servidor
# Si no están configuradas, CreatorPulse informa la limitación técnica y habilita datos verificados manuales.
PORT=3000

# YouTube Data API v3 & OAuth 2.0
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch Helix API
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick Developer API v2
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# TikTok Display API v2
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (Meta for Creators)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
